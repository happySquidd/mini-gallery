---
import { Image } from "astro:assets";
import type { ResolvedPhoto } from "../data/photos";

interface Props {
	photos: ResolvedPhoto[];
}

const { photos } = Astro.props;
---

<dialog class="lightbox" aria-label="Photo viewer">
	<button class="lb-close" aria-label="Close">&times;</button>
	<button class="lb-nav lb-prev" aria-label="Previous photo">&#8249;</button>
	<button class="lb-nav lb-next" aria-label="Next photo">&#8250;</button>

	<div class="lb-stage">
		{
			photos.map((photo, i) => (
				<figure class="lb-slide" data-index={i} hidden>
					<Image
						src={photo.image}
						alt={photo.alt}
						widths={[800, 1600, 2400]}
						sizes="100vw"
						loading="lazy"
					/>
				</figure>
			))
		}
	</div>
</dialog>

<style>
	.lightbox {
		border: 0;
		padding: 0;
		margin: 0;
		width: 100vw;
		height: 100vh;
		height: 100dvh;
		max-width: 100vw;
		max-height: 100vh;
		max-height: 100dvh;
		overflow: hidden;
		background: rgba(8, 8, 10, 0.96);
		color: var(--text);
	}

	.lightbox::backdrop {
		background: rgba(8, 8, 10, 0.96);
	}

	.lb-stage {
		--lb-pad: clamp(1rem, 5vw, 4rem);
		width: 100%;
		height: 100%;
		display: grid;
		place-items: center;
		padding: var(--lb-pad);
	}

	.lb-slide {
		margin: 0;
	}

	.lb-slide[hidden] {
		display: none;
	}

	.lb-slide :global(img) {
		display: block;
		width: auto;
		height: auto;
		max-width: calc(100vw - 2 * var(--lb-pad));
		max-height: calc(100dvh - 2 * var(--lb-pad));
		object-fit: contain;
	}

	.lb-close,
	.lb-nav {
		position: fixed;
		background: none;
		border: 0;
		color: var(--text-dim);
		cursor: pointer;
		transition: color 0.2s ease;
		z-index: 1;
		line-height: 1;
	}

	.lb-close:hover,
	.lb-nav:hover {
		color: var(--text);
	}

	.lb-close {
		top: 1.5rem;
		right: 1.75rem;
		font-size: 2.25rem;
	}

	.lb-nav {
		top: 50%;
		transform: translateY(-50%);
		font-size: 3.5rem;
		padding: 0 1.25rem;
	}

	.lb-prev {
		left: 0.5rem;
	}

	.lb-next {
		right: 0.5rem;
	}

	@media (max-width: 600px) {
		.lb-nav {
			top: auto;
			bottom: 1rem;
			transform: none;
		}
		.lb-prev {
			left: 25%;
		}
		.lb-next {
			right: 25%;
		}
	}
</style>

<script>
	const dialog = document.querySelector<HTMLDialogElement>(".lightbox");
	if (dialog) {
		const slides = [...dialog.querySelectorAll<HTMLElement>(".lb-slide")];
		const triggers = document.querySelectorAll<HTMLButtonElement>(
			"[data-lightbox-trigger]",
		);
		let current = 0;

		const show = (i: number) => {
			current = (i + slides.length) % slides.length;
			slides.forEach((slide, idx) => {
				slide.hidden = idx !== current;
			});
		};

		const open = (i: number) => {
			show(i);
			dialog.showModal();
		};

		triggers.forEach((trigger) => {
			trigger.addEventListener("click", () => {
				open(Number(trigger.dataset.lightboxTrigger));
			});
		});

		dialog
			.querySelector(".lb-close")
			?.addEventListener("click", () => dialog.close());
		dialog
			.querySelector(".lb-next")
			?.addEventListener("click", () => show(current + 1));
		dialog
			.querySelector(".lb-prev")
			?.addEventListener("click", () => show(current - 1));

		// Click on the backdrop (outside the image) closes.
		dialog.addEventListener("click", (e) => {
			if (e.target === dialog || (e.target as HTMLElement).closest(".lb-stage") === e.target) {
				dialog.close();
			}
		});

		document.addEventListener("keydown", (e) => {
			if (!dialog.open) return;
			if (e.key === "ArrowRight") show(current + 1);
			if (e.key === "ArrowLeft") show(current - 1);
		});
	}
</script>
