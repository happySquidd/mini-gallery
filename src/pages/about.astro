---
import Base from "../layouts/Base.astro";
---

<Base title="About — Studio">
	<article class="prose">
		<h1>About</h1>
		<p>
			I'm a photographer based in Cary, working in landscape,
			and nature shots. For the past year I've been drawn to quiet
			moments and natural light, capturing natural beauty.
		</p>
		<p>
			I'm a growing photographer, and I'm working on building a stunning portfolio,
			stay tuned for more photos. I'm also available for commissions, so if you're interested,
			please reach out!
		</p>
	</article>
</Base>

<style>
	.prose {
		max-width: 60ch;
		margin-inline: auto;
		padding: clamp(2rem, 8vh, 6rem) var(--gutter);
	}

	.prose h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 600;
		letter-spacing: -0.01em;
		margin-bottom: 1.5rem;
	}

	.prose p {
		color: var(--text-dim);
		margin-bottom: 1.25rem;
		font-size: 1.05rem;
	}

</style>
