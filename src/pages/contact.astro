---
import Base from "../layouts/Base.astro";

// Replace these with the photographer's real details.
const email = "hello@luno.com";
const social = [
	{ label: "Instagram", href: "https://instagram.com/" },
];
---

<Base title="Contact — Studio">
	<article class="contact">
		<h1>Contact</h1>
		<p>
			For commissions, prints, or any enquiry, get in touch, I'd love to hear
			about your project!
		</p>

		<a class="email" >{email}</a>

		<ul class="social">
			{
				social.map((item) => (
					<li>
						<a href={item.href} target="_blank" rel="noopener noreferrer">
							{item.label}
						</a>
					</li>
				))
			}
		</ul>
	</article>
</Base>

<style>
	.contact {
		max-width: 60ch;
		margin-inline: auto;
		padding: clamp(2rem, 8vh, 6rem) var(--gutter);
	}

	.contact h1 {
		font-size: clamp(2rem, 5vw, 3rem);
		font-weight: 600;
		letter-spacing: -0.01em;
		margin-bottom: 1.5rem;
	}

	.contact p {
		color: var(--text-dim);
		font-size: 1.05rem;
		margin-bottom: 2rem;
	}

	.email {
		display: inline-block;
		font-size: clamp(1.25rem, 4vw, 1.75rem);
		border-bottom: 1px solid var(--border);
		padding-bottom: 0.2rem;
		transition: border-color 0.2s ease;
	}

	.email:hover {
		border-color: var(--text);
	}

	.social {
		list-style: none;
		display: flex;
		gap: 1.5rem;
		margin-top: 3rem;
	}

	.social a {
		color: var(--text-dim);
		font-size: 0.8rem;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		transition: color 0.2s ease;
	}

	.social a:hover {
		color: var(--text);
	}
</style>
